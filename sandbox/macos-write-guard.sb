;; four-eyes write guard for macOS sandbox-exec. Deny every write by default; allow the isolated copy and
;; the run-scoped runtime-state directory. Replace the placeholders before use; run sandbox/probes.md first.
;; SBPL evaluates later rules over earlier ones: the explicit denies below the allowances win.
;; Nothing under the operator's real configuration is writable; the CLI runs with its configuration directory set to <runtime-state>.
;; <runtime-state> is one directory per role, outside <home>/.claude, <home>/.codex and <home>/.config, mode 700.
;; Seed it before the run with a copy of that CLI's credentials file only, mode 600, and delete it after the run.
(version 1)
(allow default)
(deny file-write*)
(allow file-write* (subpath "<copy>"))                                   ; the isolated copy
(allow file-write* (subpath "/private/tmp/<run-id>"))                    ; the run's own scratch, nothing else under /tmp
(allow file-write* (subpath "<runtime-state>"))                          ; CLAUDE_CONFIG_DIR for the Claude CLI, CODEX_HOME for Codex; the CLI's state, sessions and credentials copy
;; The driver sets TMPDIR=/private/tmp/<run-id>/tmp for the session, so temporary files fall under the run's scratch allowance above.
(allow file-write* (subpath "/private/tmp/claude-<uid>/<cwd-slug>"))     ; the harness temp directory for the copy (<uid> is the operator's uid); without it the CLI's shell tool fails
(allow file-write* (literal "/dev/null"))                                ; the null device
(deny file-write* (literal "<home>/.claude/CLAUDE.md"))                  ; the host's own instruction file
(deny file-write* (subpath "<home>/.claude/skills"))                     ; installed skills
(deny file-write* (subpath "<home>/.claude/agents"))                     ; installed agents
(deny file-write* (subpath "<home>/.claude/commands"))                   ; installed commands
(deny file-write* (subpath "<home>/.claude/hooks"))                      ; hooks run with the operator's credentials
(deny file-write* (regex #"^<home>/\.claude/settings[^/]*$"))            ; settings, settings.json, settings.local.json
(deny file-write* (subpath "<home>/.claude/projects"))                   ; project memory of the operator's own projects
(deny file-write* (subpath "<home>/.claude/plugins"))                    ; installed plugin code
(deny file-write* (subpath "<home>/.agents"))                            ; user-wide skills for Codex and other clients
(deny file-write* (subpath "<home>/.codex"))                             ; Codex instructions, config and auth
(deny file-write* (subpath "<home>/.config"))                            ; includes review-panel's panel file
;; Credential reads are denied for the CLI itself; it uses its seeded copy under <runtime-state>, never the real files.
(deny file-read* (subpath "<home>/.ssh"))                                ; SSH keys
(deny file-read* (subpath "<home>/.aws"))                                ; cloud credentials
(deny file-read* (subpath "<home>/.config/gh"))                          ; GitHub CLI credentials
(deny file-read* (literal "<home>/.claude/.credentials.json"))           ; the real Claude credentials file
(deny file-read* (literal "<home>/.codex/auth.json"))                    ; the real Codex auth file
